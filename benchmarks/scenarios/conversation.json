{
  "name": "conversation",
  "description": "One representative session with the robot, the user waiting for it to be idle before speaking again (expect_idle, no timers): a greeting, a question, a long story interrupted by 'Stop!' as soon as it starts, two utterances half a second apart, a goodbye. The script only drives the conversation; what is judged is the rule list.",
  "requires": {
    "inputs": [
      "speech_input"
    ],
    "output_command": true
  },
  "timeout_s": 300,
  "checks": [
    "answers_each_input",
    "no_noop_on_input",
    "no_failed_reactions",
    "no_colliding_cancel",
    {
      "name": "cancels_when_asked",
      "args": {
        "requests": [
          {
            "key": "speech_input",
            "value": "Stop!"
          }
        ]
      }
    }
  ],
  "params": {},
  "script": [
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "Hello there!"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_idle",
          "args": {
            "within": 90
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "What can you do?"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_idle",
          "args": {
            "within": 90
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "Tell me a long story about a robot who learns to dance, at least five sentences."
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_output",
          "args": {
            "within": 30
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "Stop!"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_idle",
          "args": {
            "within": 90
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "Hi, I'm Alex."
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "wait",
          "args": {
            "seconds": 0.5
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "Can you hear me?"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_idle",
          "args": {
            "within": 90
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "Thanks, that's all for now. Goodbye!"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_idle",
          "args": {
            "within": 90
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "finish",
          "args": {
            "verdict": "pass"
          }
        }
      ]
    }
  ]
}
