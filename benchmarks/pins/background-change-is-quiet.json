{
  "name": "background-change-is-quiet",
  "description": "The noop clause on the re-trigger step: a passive entry (emotion) changes while the reply is still being spoken; the step the reply's completion wakes must noop, not comment on it.",
  "requires": {
    "inputs": [
      "speech_input",
      "emotion"
    ],
    "output_command": true
  },
  "timeout_s": 60,
  "checks": [
    "answers_each_input",
    "no_noop_on_input",
    "no_failed_reactions",
    "no_colliding_cancel"
  ],
  "params": {},
  "script": [
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "Hi!"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_output",
          "args": {
            "within": 15
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "set_emotion",
          "args": {
            "value": "happy"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_no_action",
          "args": {
            "name": "say",
            "for_": 4
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "finish",
          "args": {
            "verdict": "pass"
          }
        }
      ]
    }
  ]
}
