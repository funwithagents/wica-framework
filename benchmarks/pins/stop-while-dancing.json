{
  "name": "stop-while-dancing",
  "description": "A dance is asked for, then stopped mid-way: cancel_command, then a spoken confirmation.",
  "requires": {
    "inputs": [
      "speech_input"
    ],
    "commands": [
      "dance"
    ],
    "output_command": true
  },
  "timeout_s": 90,
  "checks": [
    "answers_each_input",
    "no_noop_on_input",
    "no_failed_reactions",
    "no_colliding_cancel"
  ],
  "params": {},
  "script": [
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "Please dance for me!"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_action",
          "args": {
            "name": "dance",
            "within": 15
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "set_speech_input",
          "args": {
            "value": "Stop!"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_action",
          "args": {
            "name": "cancel_command",
            "within": 15
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "expect_output",
          "args": {
            "within": 15
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "finish",
          "args": {
            "verdict": "pass"
          }
        }
      ]
    }
  ]
}
