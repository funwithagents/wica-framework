# Python
__pycache__/
*.py[cod]
*.egg-info/

# uv / venv
.venv/

# Test / tool caches
.pytest_cache/
.ruff_cache/

# Reports the toolkit-driven e2e tests write when run with --wica-report-dir (specs/wica-tester.md)
tests-e2e/reports/

# Benchmark batches (specs/benchmark.md): working data; kept results live in benchmarks/results/
benchmarks/runs/

# Local working notes (the tester study, the codebase analysis, the todo list) — referenced from
# specs and plans as `analysis/...`, deliberately not committed.
analysis/

# Claude Code personal settings (not shared)
.claude/settings.local.json

# Local config overrides you create yourself (a config never holds a key: specs/config.md,
# "API key: never in the config").
**/*.local.json

# Keys saved next to a config (the demo run from a file, the config app): the .env beside the
# config it serves, never committed (specs/conversation-demo.md).
.env
