# Python
__pycache__/
*.py[cod]
*.egg-info/

# uv / venv
.venv/

# Test / tool caches
.pytest_cache/
.ruff_cache/

# Reports the toolkit-driven e2e tests write when run with --wica-report-dir (specs/wica-tester.md)
tests-e2e/reports/

# Benchmark batches (specs/benchmark.md): working data; kept results live in benchmarks/results/
benchmarks/runs/

# Local working notes (the tester study, the codebase analysis, the todo list) — referenced from
# specs and plans as `analysis/...`, deliberately not committed.
analysis/

# Claude Code personal settings (not shared)
.claude/settings.local.json

# WICA config files with a literal api_key (see specs/config.md "API key: literal or env
# reference") — a local override you create yourself; committed configs use api_key_env instead.
**/*.local.json
